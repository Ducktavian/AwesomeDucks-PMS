	<parameter name="PREPARED_BY" class="java.lang.String">
		<defaultValueExpression><![CDATA["Finance Department"]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    CAST(pr.employee_id AS CHAR) AS employee_id,
    CONCAT(e.first_name, ' ', e.last_name) AS employee_name,
    COALESCE(ep.position_name, '-') AS position_name,
    COALESCE(d.department_name, '-') AS department_name,

    CAST(COALESCE(pr.gross_pay, 0) AS DECIMAL(10,2)) AS gross_income,

    COALESCE(gov.sss_no, '-') AS sss_no,
    CAST(COALESCE(ded.sss_contrib, 0) AS DECIMAL(10,2)) AS sss_contrib,

    COALESCE(gov.philhealth_no, '-') AS philhealth_no,
    CAST(COALESCE(ded.philhealth_contrib, 0) AS DECIMAL(10,2)) AS philhealth_contrib,

    COALESCE(gov.pagibig_no, '-') AS pagibig_no,
    CAST(COALESCE(ded.pagibig_contrib, 0) AS DECIMAL(10,2)) AS pagibig_contrib,

    COALESCE(gov.tin_no, '-') AS tin_no,
    CAST(COALESCE(ded.withholding_tax, 0) AS DECIMAL(10,2)) AS withholding_tax,

    CAST(COALESCE(pr.net_pay, 0) AS DECIMAL(10,2)) AS net_pay,

    COALESCE(DATE_FORMAT(report_period.report_start_date, '%m/%d/%Y'), '-') AS report_start_date_text,
    COALESCE(DATE_FORMAT(report_period.report_end_date, '%m/%d/%Y'), '-') AS report_end_date_text

FROM payroll pr

LEFT JOIN employee e
    ON pr.employee_id = e.employee_id

LEFT JOIN employee_position ep
    ON e.position_id = ep.position_id

LEFT JOIN department d
    ON ep.department_id = d.department_id

LEFT JOIN pay_period pp
    ON pr.pay_period_id = pp.pay_period_id

LEFT JOIN (
    SELECT
        employee_id,
        MAX(CASE WHEN government_id_type_id = 1 THEN id_number END) AS sss_no,
        MAX(CASE WHEN government_id_type_id = 2 THEN id_number END) AS philhealth_no,
        MAX(CASE WHEN government_id_type_id = 3 THEN id_number END) AS tin_no,
        MAX(CASE WHEN government_id_type_id = 4 THEN id_number END) AS pagibig_no
    FROM employee_government_id
    GROUP BY employee_id
) gov
    ON pr.employee_id = gov.employee_id

LEFT JOIN (
    SELECT
        payroll_id,
        SUM(CASE WHEN deduction_type_id = 1 THEN amount ELSE 0 END) AS sss_contrib,
        SUM(CASE WHEN deduction_type_id = 2 THEN amount ELSE 0 END) AS philhealth_contrib,
        SUM(CASE WHEN deduction_type_id = 3 THEN amount ELSE 0 END) AS pagibig_contrib,
        SUM(CASE WHEN deduction_type_id = 4 THEN amount ELSE 0 END) AS withholding_tax
    FROM payroll_deduction
    GROUP BY payroll_id
) ded
    ON pr.payroll_id = ded.payroll_id

CROSS JOIN (
    SELECT
        MIN(period_start_date) AS report_start_date,
        MAX(period_end_date) AS report_end_date
    FROM pay_period
) report_period

ORDER BY pr.employee_id, pr.payroll_id]]></query>
