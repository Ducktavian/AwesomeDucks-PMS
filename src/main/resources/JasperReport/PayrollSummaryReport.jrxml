	<parameter name="LOGO_PATH" class="java.lang.String">
		<defaultValueExpression><![CDATA["C:/Users/Lenovo/Downloads/Work_S/MMDC/AOOP/MotorPH-icon.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="REPORT_PERIOD" class="java.lang.String">
		<defaultValueExpression><![CDATA["All Payroll Records"]]></defaultValueExpression>
	</parameter>
	<parameter name="PREPARED_BY" class="java.lang.String">
		<defaultValueExpression><![CDATA["Finance Department"]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    COALESCE(ps.payslip_number, CONCAT('PS-', LPAD(p.payroll_id, 3, '0'))) AS payslip_id,
    p.employee_id,
    COALESCE(DATE_FORMAT(ap.start_date, '%m/%d/%Y'), '-') AS start_date_text,
    COALESCE(DATE_FORMAT(ap.end_date, '%m/%d/%Y'), '-') AS end_date_text,
    CAST(COALESCE(p.gross_pay, 0) AS DECIMAL(10,2)) AS gross_pay,
    CAST(COALESCE(p.total_deductions, 0) AS DECIMAL(10,2)) AS deduction,
    CAST(COALESCE(pb.allowance, 0) AS DECIMAL(10,2)) AS allowance,
    CAST(COALESCE(p.net_pay, 0) AS DECIMAL(10,2)) AS net_pay

FROM payroll p

LEFT JOIN payslip ps
    ON ps.payroll_id = p.payroll_id

LEFT JOIN (
    SELECT
        payroll_id,
        SUM(amount) AS allowance
    FROM payroll_benefit
    GROUP BY payroll_id
) pb
    ON p.payroll_id = pb.payroll_id

LEFT JOIN (
    SELECT
        employee_id,
        MIN(attendance_date) AS start_date,
        MAX(attendance_date) AS end_date
    FROM attendance
    GROUP BY employee_id
) ap
    ON p.employee_id = ap.employee_id

ORDER BY p.payroll_id DESC]]></query>
	<field name="payslip_id" class="java.lang.String"/>
	<field name="employee_id" class="java.lang.Integer"/>
	<field name="start_date_text" class="java.lang.String"/>
	<field name="end_date_text" class="java.lang.String"/>
	<field name="gross_pay" class="java.math.BigDecimal"/>
	<field name="deduction" class="java.math.BigDecimal"/>
	<field name="allowance" class="java.math.BigDecimal"/>
	<field name="net_pay" class="java.math.BigDecimal"/>
	<variable name="TOTAL_GROSS_PAY" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{gross_pay}]]></expression>
	</variable>
	<variable name="TOTAL_DEDUCTIONS_AMOUNT" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{deduction}]]></expression>
	</variable>
	<variable name="TOTAL_ALLOWANCE_AMOUNT" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{allowance}]]></expression>
	</variable>
	<variable name="TOTAL_NET_PAY" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{net_pay}]]></expression>
	</variable>
