	<parameter name="LOGO_PATH" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="REPORT_PERIOD" class="java.lang.String">
		<defaultValueExpression><![CDATA["All Payroll Records"]]></defaultValueExpression>
	</parameter>
	<parameter name="PREPARED_BY" class="java.lang.String">
		<defaultValueExpression><![CDATA["Finance Department"]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    e.employee_id,
    CONCAT(e.first_name, ' ', e.last_name) AS employee_name,
    ep.position_name,
    d.department_name,
    p.gross_pay,
    p.total_deductions,
    p.net_pay
FROM payroll p
JOIN employee e
    ON p.employee_id = e.employee_id
JOIN employee_position ep
    ON e.position_id = ep.position_id
JOIN department d
    ON ep.department_id = d.department_id
ORDER BY p.payroll_id DESC]]></query>
	<field name="employee_id" class="java.lang.Integer"/>
	<field name="employee_name" class="java.lang.String"/>
	<field name="position_name" class="java.lang.String"/>
	<field name="department_name" class="java.lang.String"/>
	<field name="gross_pay" class="java.math.BigDecimal"/>
	<field name="total_deductions" class="java.math.BigDecimal"/>
	<field name="net_pay" class="java.math.BigDecimal"/>
	<variable name="TOTAL_GROSS_PAY" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{gross_pay}]]></expression>
	</variable>
	<variable name="TOTAL_DEDUCTIONS_AMOUNT" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{total_deductions}]]></expression>
	</variable>
	<variable name="TOTAL_NET_PAY" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{net_pay}]]></expression>
	</variable>
