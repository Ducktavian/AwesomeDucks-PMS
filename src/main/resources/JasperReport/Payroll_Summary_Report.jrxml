<jasperReport name="MotorPH_Clone_Report" language="java" pageWidth="1600" pageHeight="900" orientation="Landscape" columnWidth="1570" leftMargin="15" rightMargin="15" topMargin="15" bottomMargin="15" uuid="7dab6986-e4d4-4601-a5ff-206c02ed8510">
	<query language="sql"><![CDATA[SELECT
 e.employee_id,
 CONCAT(e.first_name,' ',e.last_name) employee_name,
 ep.position_name,
 d.department_name,
 p.gross_pay,
 p.total_deductions,
 p.net_pay
FROM payroll p
JOIN employee e ON p.employee_id=e.employee_id
JOIN employee_position ep ON e.position_id=ep.position_id
JOIN department d ON ep.department_id=d.department_id
ORDER BY p.payroll_id DESC]]></query>
	<field name="employee_id" class="java.lang.Integer"/>
	<field name="employee_name" class="java.lang.String"/>
	<field name="position_name" class="java.lang.String"/>
	<field name="department_name" class="java.lang.String"/>
	<field name="gross_pay" class="java.math.BigDecimal"/>
	<field name="total_deductions" class="java.math.BigDecimal"/>
	<field name="net_pay" class="java.math.BigDecimal"/>
