<jasperReport name="EmployeeTimecard" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d4244c91-44d7-47fa-9759-29cf252c0f01">
