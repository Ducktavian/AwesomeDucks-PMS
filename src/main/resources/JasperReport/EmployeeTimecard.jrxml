	<query language="SQL"><![CDATA[SELECT
    work_date AS date,
    day_name AS day,
    time_in,
    break_out,
    break_in,
    time_out,
    total_hours_worked,
    remarks
FROM v_employee_timecard
WHERE employee_id = $P{EMPLOYEE_ID}
ORDER BY work_date]]></query>
