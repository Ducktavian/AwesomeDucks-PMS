	<parameter name="LOGO" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[Thread.currentThread().getContextClassLoader().getResourceAsStream("JasperReport/MotorPH-icon.png")]]></defaultValueExpression>
	</parameter>
	<parameter name="EMPLOYEE_ID" class="java.lang.Integer"/>
	<parameter name="MONTH" class="java.lang.Integer"/>
	<parameter name="YEAR" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT
    a.employee_id,
    CONCAT(e.last_name, ', ', e.first_name) AS employee_name,

    DATE_FORMAT(STR_TO_DATE(CONCAT($P{YEAR}, '-', $P{MONTH}, '-01'), '%Y-%m-%d'), '%M %Y') AS payroll_date_text,
    CASE
        WHEN DAY(a.attendance_date) BETWEEN 1 AND 15 THEN '1st Cutoff'
        ELSE '2nd Cutoff'
    END AS payroll_period,

    DATE_FORMAT(a.attendance_date, '%m/%d/%Y') AS attendance_date_text,

    CASE
        WHEN LOWER(COALESCE(ats.status_name, '')) LIKE '%holiday%' THEN 'Holiday'
        WHEN a.time_in IS NOT NULL
             AND a.time_out IS NOT NULL
             AND ROUND(TIME_TO_SEC(TIMEDIFF(a.time_out, a.time_in)) / 3600, 2) > 8 THEN 'Overtime'
        ELSE 'Regular'
    END AS attendance_type,

    CASE
        WHEN a.time_in IS NULL THEN ''
        ELSE TIME_FORMAT(a.time_in, '%h:%i %p')
    END AS time_in_text,

    CASE
        WHEN a.time_out IS NULL THEN ''
        ELSE TIME_FORMAT(a.time_out, '%h:%i %p')
    END AS time_out_text,

    CASE
        WHEN a.time_in IS NOT NULL AND a.time_out IS NOT NULL
        THEN CAST(ROUND(TIME_TO_SEC(TIMEDIFF(a.time_out, a.time_in)) / 3600, 2) AS CHAR)
        ELSE '0'
    END AS total_hours_worked,

    CASE
        WHEN a.time_in IS NULL OR a.time_out IS NULL THEN 'Invalid'
        ELSE 'Valid'
    END AS validity

FROM attendance a
LEFT JOIN employee e
    ON a.employee_id = e.employee_id
LEFT JOIN attendance_status ats
    ON a.attendance_status_id = ats.attendance_status_id
WHERE a.employee_id = $P{EMPLOYEE_ID}
    AND MONTH(a.attendance_date) = $P{MONTH}
    AND YEAR(a.attendance_date) = $P{YEAR}
ORDER BY
    a.employee_id,
    a.attendance_date]]></query>
	<field name="employee_id" class="java.lang.Integer"/>
	<field name="employee_name" class="java.lang.String"/>
	<field name="payroll_date_text" class="java.lang.String"/>
	<field name="payroll_period" class="java.lang.String"/>
	<field name="attendance_date_text" class="java.lang.String"/>
	<field name="attendance_type" class="java.lang.String"/>
	<field name="time_in_text" class="java.lang.String"/>
	<field name="time_out_text" class="java.lang.String"/>
	<field name="total_hours_worked" class="java.lang.String"/>
	<field name="validity" class="java.lang.String"/>
