	<parameter name="LOGO_PATH" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    a.employee_id,
    CONCAT(e.last_name, ', ', e.first_name) AS employee_name,
    CONCAT(COALESCE(ep.position_name, ''), ' / ', COALESCE(d.department_name, '')) AS position_department,
    DATE_FORMAT(a.attendance_date, '%m/%d/%Y') AS attendance_date_text,
    DATE_FORMAT(a.attendance_date, '%a') AS attendance_day,
    CASE
        WHEN a.time_in IS NULL THEN ''
        ELSE TIME_FORMAT(a.time_in, '%h:%i %p')
    END AS time_in_text,
    '' AS break_out,
    '' AS break_in,
    CASE
        WHEN a.time_out IS NULL THEN ''
        ELSE TIME_FORMAT(a.time_out, '%h:%i %p')
    END AS time_out_text,
    CASE
        WHEN a.time_in IS NOT NULL AND a.time_out IS NOT NULL
        THEN CAST(ROUND(TIME_TO_SEC(TIMEDIFF(a.time_out, a.time_in)) / 3600, 2) AS CHAR)
        ELSE '0'
    END AS total_hours_worked,
    CAST(a.attendance_status_id AS CHAR) AS remarks
FROM attendance a
LEFT JOIN employee e
    ON a.employee_id = e.employee_id
LEFT JOIN employee_position ep
    ON e.position_id = ep.position_id
LEFT JOIN department d
    ON ep.department_id = d.department_id
ORDER BY a.employee_id, a.attendance_date]]></query>
	<field name="employee_id" class="java.lang.Integer"/>
	<field name="employee_name" class="java.lang.String"/>
	<field name="position_department" class="java.lang.String"/>
	<field name="attendance_date_text" class="java.lang.String"/>
	<field name="attendance_day" class="java.lang.String"/>
	<field name="time_in_text" class="java.lang.String"/>
	<field name="break_out" class="java.lang.String"/>
	<field name="break_in" class="java.lang.String"/>
	<field name="time_out_text" class="java.lang.String"/>
	<field name="total_hours_worked" class="java.lang.String"/>
	<field name="remarks" class="java.lang.String"/>
