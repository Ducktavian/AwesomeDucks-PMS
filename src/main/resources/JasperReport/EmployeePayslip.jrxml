	<parameter name="LOGO" class="java.io.InputStream"/>
	<parameter name="PAYROLL_ID" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT
    pr.payroll_id,
    COALESCE(ps.payslip_number, CONCAT('PAY-', pr.employee_id)) AS payslip_number,
    pr.employee_id,
    CONCAT(e.last_name, ', ', e.first_name) AS employee_name,
    ep.position_name AS position,
    d.department_name AS department,

    DATE_FORMAT(COALESCE(pp.pay_date, att.payroll_date, CURDATE()), '%m/%d/%Y') AS payroll_date_text,
    CASE
        WHEN DAY(pp.period_start_date) BETWEEN 1 AND 15 THEN '1st Cutoff'
        ELSE '2nd Cutoff'
    END AS payroll_period,
    pp.period_start_date AS period_start,
    pp.period_end_date AS period_end,

    CAST(COALESCE(pr.gross_pay, 0) AS DECIMAL(10,2)) AS basic_salary,
    CAST(COALESCE(pr.gross_pay, 0) AS DECIMAL(10,2)) AS monthly_salary,

    CAST(COALESCE(att.hours_worked, 0) AS DECIMAL(10,2)) AS hours_worked,
    CAST(
        CASE
            WHEN COALESCE(att.hours_worked, 0) > 0
            THEN COALESCE(pr.gross_pay, 0) / att.hours_worked
            ELSE 0
        END AS DECIMAL(10,2)
    ) AS hourly_rate,

    CAST(
        CASE
            WHEN COALESCE(att.hours_worked, 0) > 0
            THEN COALESCE(pr.gross_pay, 0) / att.hours_worked
            ELSE 0
        END AS DECIMAL(10,2)
    ) AS daily_rate,

    CAST(COALESCE(att.days_worked, 0) AS SIGNED) AS days_worked,
    CAST(COALESCE(att.overtime_hours, 0) AS DECIMAL(10,2)) AS overtime_hours,
    CAST(0 AS DECIMAL(10,2)) AS holiday_pay,

    CAST(COALESCE(b.rice_subsidy, 0) AS DECIMAL(10,2)) AS rice_subsidy,
    CAST(COALESCE(b.phone_allowance, 0) AS DECIMAL(10,2)) AS phone_allowance,
    CAST(COALESCE(b.clothing_allowance, 0) AS DECIMAL(10,2)) AS clothing_allowance,
    COALESCE(b.bonus_type, '-') AS bonus_type,
    CAST(COALESCE(b.bonus_amount, 0) AS DECIMAL(10,2)) AS bonus_amount,
    CAST(COALESCE(b.total_benefits, 0) AS DECIMAL(10,2)) AS total_benefits,

    CAST(COALESCE(pd.sss, 0) AS DECIMAL(10,2)) AS sss,
    CAST(COALESCE(pd.philhealth, 0) AS DECIMAL(10,2)) AS philhealth,
    CAST(COALESCE(pd.pagibig, 0) AS DECIMAL(10,2)) AS pagibig,
    CAST(COALESCE(pd.withholding_tax, 0) AS DECIMAL(10,2)) AS withholding_tax,

    CAST(COALESCE(pr.gross_pay, 0) AS DECIMAL(10,2)) AS gross_income,
    CAST(COALESCE(pr.total_deductions, 0) AS DECIMAL(10,2)) AS total_deductions,
    CAST(COALESCE(pr.net_pay, 0) AS DECIMAL(10,2)) AS net_pay,

    -- Taxable income isn't persisted; reconstruct it the same way JdbcPayslipDAO
    -- does. Only meaningful when withholding tax was actually applied (i.e. the
    -- 2nd cutoff), otherwise 0 to match the view-payroll panel.
    CAST(
        CASE
            WHEN COALESCE(pd.withholding_tax, 0) > 0
            THEN COALESCE(pr.gross_pay, 0)
                 - COALESCE(b.rice_subsidy, 0)
                 - COALESCE(b.phone_allowance, 0)
                 - COALESCE(b.clothing_allowance, 0)
                 - COALESCE(pr.overtime_pay, 0)
                 - COALESCE(pd.sss, 0)
                 - COALESCE(pd.philhealth, 0)
                 - COALESCE(pd.pagibig, 0)
            ELSE 0
        END AS DECIMAL(10,2)
    ) AS taxable_income

FROM payroll pr

LEFT JOIN pay_period pp
    ON pr.pay_period_id = pp.pay_period_id

LEFT JOIN payslip ps
    ON ps.payroll_id = pr.payroll_id

LEFT JOIN employee e
    ON pr.employee_id = e.employee_id

LEFT JOIN employee_position ep
    ON e.position_id = ep.position_id

LEFT JOIN department d
    ON ep.department_id = d.department_id

LEFT JOIN (
    SELECT
        employee_id,
        MAX(attendance_date) AS payroll_date,
        COUNT(DISTINCT attendance_date) AS days_worked,
        SUM(
            CASE
                WHEN time_in IS NOT NULL AND time_out IS NOT NULL
                THEN ROUND(TIME_TO_SEC(TIMEDIFF(time_out, time_in)) / 3600, 2)
                ELSE 0
            END
        ) AS hours_worked,
        SUM(
            CASE
                WHEN time_in IS NOT NULL AND time_out IS NOT NULL
                     AND ROUND(TIME_TO_SEC(TIMEDIFF(time_out, time_in)) / 3600, 2) > 8
                THEN ROUND(TIME_TO_SEC(TIMEDIFF(time_out, time_in)) / 3600, 2) - 8
                ELSE 0
            END
        ) AS overtime_hours
    FROM attendance
    GROUP BY employee_id
) att
    ON pr.employee_id = att.employee_id

LEFT JOIN (
    SELECT
        payroll_id,
        SUM(CASE WHEN benefit_type_id = 1 THEN amount ELSE 0 END) AS rice_subsidy,
        SUM(CASE WHEN benefit_type_id = 2 THEN amount ELSE 0 END) AS phone_allowance,
        SUM(CASE WHEN benefit_type_id = 3 THEN amount ELSE 0 END) AS clothing_allowance,
        MAX(CASE WHEN benefit_type_id NOT IN (1, 2, 3) THEN CONCAT('Benefit Type ', benefit_type_id) ELSE NULL END) AS bonus_type,
        SUM(CASE WHEN benefit_type_id NOT IN (1, 2, 3) THEN amount ELSE 0 END) AS bonus_amount,
        SUM(amount) AS total_benefits
    FROM payroll_benefit
    GROUP BY payroll_id
) b
    ON pr.payroll_id = b.payroll_id

LEFT JOIN (
    SELECT
        payroll_id,
        SUM(CASE WHEN deduction_type_id = 1 THEN amount ELSE 0 END) AS sss,
        SUM(CASE WHEN deduction_type_id = 2 THEN amount ELSE 0 END) AS philhealth,
        SUM(CASE WHEN deduction_type_id = 3 THEN amount ELSE 0 END) AS pagibig,
        SUM(CASE WHEN deduction_type_id = 4 THEN amount ELSE 0 END) AS withholding_tax
    FROM payroll_deduction
    GROUP BY payroll_id
) pd
    ON pr.payroll_id = pd.payroll_id

WHERE pr.payroll_id = $P{PAYROLL_ID}

ORDER BY pr.payroll_id DESC]]></query>
