	<parameter name="LOGO" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    p.employee_id,
    CONCAT(e.last_name, ', ', e.first_name) AS employee_name,
    ep.position_name AS position,
    d.department_name AS department,

    CAST(NULL AS DATE) AS period_start,
    CAST(NULL AS DATE) AS period_end,

    CAST(0 AS DECIMAL(10,2)) AS monthly_salary,
    CAST(0 AS DECIMAL(10,2)) AS daily_rate,
    CAST(0 AS SIGNED) AS days_worked,
    CAST(0 AS DECIMAL(10,2)) AS overtime_hours,

    CAST(0 AS DECIMAL(10,2)) AS rice_subsidy,
    CAST(0 AS DECIMAL(10,2)) AS phone_allowance,
    CAST(0 AS DECIMAL(10,2)) AS clothing_allowance,

    CAST(0 AS DECIMAL(10,2)) AS sss,
    CAST(0 AS DECIMAL(10,2)) AS philhealth,
    CAST(0 AS DECIMAL(10,2)) AS pagibig,
    CAST(0 AS DECIMAL(10,2)) AS withholding_tax,

    p.gross_pay AS gross_income,
    COALESCE(b.total_benefits, 0) AS total_benefits,
    p.total_deductions AS total_deductions,
    p.net_pay AS net_pay
FROM payroll p
LEFT JOIN employee e
    ON p.employee_id = e.employee_id
LEFT JOIN employee_position ep
    ON e.position_id = ep.position_id
LEFT JOIN department d
    ON ep.department_id = d.department_id
LEFT JOIN (
    SELECT
        payroll_id,
        SUM(amount) AS total_benefits
    FROM payroll_benefit
    GROUP BY payroll_id
) b
    ON p.payroll_id = b.payroll_id
ORDER BY p.payroll_id DESC]]></query>
